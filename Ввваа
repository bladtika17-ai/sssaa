<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cosmic Glass</title>
<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    color: #fff;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "SF Pro Text",
        "Segoe UI",
        sans-serif;
}
/* =========================
   SPACE BACKGROUND
========================= */
body {
    background:
        radial-gradient(
            circle at 50% 50%,
            #11131a 0%,
            #07080d 35%,
            #020204 70%,
            #000 100%
        );
}
#stars {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}
/* Большое космическое свечение */
.cosmic-glow {
    position: fixed;
    width: 700px;
    height: 700px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background:
        radial-gradient(
            circle,
            rgba(120, 140, 255, .12),
            rgba(80, 80, 180, .05) 35%,
            transparent 70%
        );
    filter: blur(55px);
    pointer-events: none;
    z-index: 1;
    animation:
        cosmicPulse 9s ease-in-out infinite alternate;
}
@keyframes cosmicPulse {
    from {
        transform: translate(-50%, -50%) scale(.85);
    }
    to {
        transform: translate(-50%, -50%) scale(1.2);
    }
}
/* =========================
   CURSOR GLOW
========================= */
.cursor-glow {
    position: fixed;
    width: 280px;
    height: 280px;
    left: 0;
    top: 0;
    border-radius: 50%;
    background:
        radial-gradient(
            circle,
            rgba(170, 185, 255, .16),
            rgba(100, 120, 255, .07) 30%,
            transparent 70%
        );
    filter: blur(12px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;
    transition:
        opacity .3s ease;
}
/* =========================
   PAGE
========================= */
.page {
    position: relative;
    z-index: 5;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    animation:
        pageAppear 1.2s cubic-bezier(.22, 1, .36, 1)
        forwards;
}
@keyframes pageAppear {
    from {
        opacity: 0;
        transform: scale(1.04);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}
/* =========================
   LIQUID GLASS
========================= */
.glass {
    position: relative;
    width: min(440px, 92vw);
    padding:
        48px
        32px
        32px;
    border-radius: 36px;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.12),
            rgba(255,255,255,.045)
        );
    border:
        1px solid rgba(255,255,255,.17);
    backdrop-filter:
        blur(35px)
        saturate(170%);
    -webkit-backdrop-filter:
        blur(35px)
        saturate(170%);
    box-shadow:
        0 40px 100px rgba(0,0,0,.7),
        inset 0 1px 1px rgba(255,255,255,.18),
        inset 0 -1px 1px rgba(255,255,255,.04);
    text-align: center;
    overflow: hidden;
    animation:
        cardAppear 1.3s
        cubic-bezier(.22,1,.36,1)
        .15s
        both;
    transition:
        transform .15s ease-out,
        box-shadow .3s ease;
}
@keyframes cardAppear {
    from {
        opacity: 0;
        transform:
            translateY(35px)
            scale(.93);
        filter: blur(12px);
    }
    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
        filter: blur(0);
    }
}
/* Верхний блик */
.glass::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    height: 1px;
    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.75),
            transparent
        );
    opacity: .8;
}
/* Внутренний переливающийся свет */
.glass::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    left: -150px;
    top: -150px;
    border-radius: 50%;
    background:
        radial-gradient(
            circle,
            rgba(255,255,255,.10),
            transparent 70%
        );
    filter: blur(15px);
    pointer-events: none;
    animation:
        glassLight 8s ease-in-out infinite;
}
@keyframes glassLight {
    0%,100% {
        transform: translate(0,0);
    }
    50% {
        transform: translate(360px,250px);
    }
}
/* =========================
   ICON
========================= */
.logo {
    position: relative;
    width: 86px;
    height: 86px;
    margin:
        0 auto
        22px;
    border-radius: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.16),
            rgba(255,255,255,.045)
        );
    border:
        1px solid rgba(255,255,255,.2);
    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.2),
        0 15px 40px rgba(0,0,0,.35);
    animation:
        logoFloat 4s ease-in-out infinite;
}
@keyframes logoFloat {
    0%,100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-8px);
    }
}
/* =========================
   TEXT
========================= */
h1 {
    font-size:
        clamp(34px, 9vw, 52px);
    line-height: 1;
    letter-spacing: -2px;
    font-weight: 750;
    margin-bottom: 16px;
    background:
        linear-gradient(
            110deg,
            #ffffff 10%,
            #dce2ff 45%,
            #ffffff 70%,
            #aeb8ff
        );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
        textShine 6s linear infinite;
}
@keyframes textShine {
    to {
        background-position:
            220% center;
    }
}
.subtitle {
    color:
        rgba(255,255,255,.58);
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 31px;
}
/* =========================
   BUTTON
========================= */
.telegram-button {
    position: relative;
    width: 100%;
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: 21px;
    text-decoration: none;
    color: #fff;
    font-size: 17px;
    font-weight: 650;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.19),
            rgba(255,255,255,.055)
        );
    border:
        1px solid rgba(255,255,255,.22);
    backdrop-filter:
        blur(20px);
    -webkit-backdrop-filter:
        blur(20px);
    box-shadow:
        inset 0 1px rgba(255,255,255,.22),
        0 15px 40px rgba(0,0,0,.35);
    overflow: hidden;
    transition:
        transform .25s cubic-bezier(.22,1,.36,1),
        background .25s ease,
        box-shadow .25s ease;
}
/* Световой проход */
.telegram-button::before {
    content: "";
    position: absolute;
    top: -20%;
    left: -120%;
    width: 70%;
    height: 140%;
    background:
        linear-gradient(
            105deg,
            transparent,
            rgba(255,255,255,.30),
            transparent
        );
    transform: skewX(-20deg);
    transition:
        left .8s cubic-bezier(.22,1,.36,1);
}
.telegram-button:hover::before {
    left: 150%;
}
.telegram-button:hover {
    transform:
        translateY(-4px)
        scale(1.015);
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.25),
            rgba(255,255,255,.075)
        );
    box-shadow:
        inset 0 1px rgba(255,255,255,.28),
        0 20px 55px rgba(0,0,0,.5);
}
.telegram-button:active {
    transform:
        scale(.965);
}
/* Telegram icon */
.telegram-icon {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background:
        rgba(255,255,255,.12);
    border:
        1px solid rgba(255,255,255,.12);
    font-size: 15px;
}
/* =========================
   FOOTER
========================= */
.footer {
    margin-top: 23px;
    font-size: 12px;
    color:
        rgba(255,255,255,.30);
    letter-spacing:
        .5px;
}
/* =========================
   MOBILE
========================= */
@media (max-width: 480px) {
    .glass {
        padding:
            39px
            22px
            27px;
        border-radius: 30px;
    }
    .logo {
        width: 72px;
        height: 72px;
        font-size: 34px;
        border-radius: 23px;
    }
    h1 {
        font-size: 39px;
    }
    .subtitle {
        font-size: 14px;
    }
    .telegram-button {
        min-height: 58px;
    }
}
/* Если устройство не поддерживает hover */
@media (hover: none) {
    .cursor-glow {
        display: none;
    }
}
/* Отключение анимаций */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>
<body>
<div class="cosmic-glow"></div>
<div class="cursor-glow" id="cursorGlow"></div>
<main class="page">
<section class="glass" id="glassCard">
    <div class="logo">
        🌌
    </div>
    <h1>
        Cosmic Space
    </h1>
    <p class="subtitle">
        Добро пожаловать в наше пространство.<br>
        Нажми кнопку ниже, чтобы продолжить.
    </p>
    <a
        href="https://t.me/+WmCwxOTHEMQ0N2My"
        target="_blank"
        rel="noopener noreferrer"
        class="telegram-button"
    >
        <span class="telegram-icon">
            ✈
        </span>
        <span>
            Открыть Telegram
        </span>
    </a>
    <div class="footer">
        ✦ Welcome to the universe ✦
    </div>
</section>
</main>
<script>
/* ==========================================
   STAR FIELD
========================================== */
const canvas =
    document.getElementById("stars");
const ctx =
    canvas.getContext("2d");
let width;
let height;
let dpr;
let stars = [];
function resizeCanvas() {
    width =
        window.innerWidth;
    height =
        window.innerHeight;
    dpr =
        Math.min(
            window.devicePixelRatio || 1,
            2
        );
    canvas.width =
        width * dpr;
    canvas.height =
        height * dpr;
    canvas.style.width =
        width + "px";
    canvas.style.height =
        height + "px";
    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );
    createStars();
}
function createStars() {
    const count =
        Math.min(
            350,
            Math.floor(
                width * height / 4200
            )
        );
    stars = [];
    for (
        let i = 0;
        i < count;
        i++
    ) {
        stars.push({
            x:
                Math.random() * width,
            y:
                Math.random() * height,
            radius:
                Math.random() * 1.25 + .15,
            speed:
                Math.random() * .65 + .08,
            opacity:
                Math.random() * .8 + .15,
            twinkle:
                Math.random() *
                Math.PI * 2,
            twinkleSpeed:
                Math.random() *
                .025 + .006
        });
    }
}
function animateStars() {
    ctx.clearRect(
        0,
        0,
        width,
        height
    );
    for (const star of stars) {
        /*
         * Падающее движение
         */
        star.y += star.speed;
        /*
         * Возвращаем звезду наверх
         */
        if (star.y > height + 10) {
            star.y = -10;
            star.x =
                Math.random() * width;
        }
        /*
         * Мерцание
         */
        star.twinkle +=
            star.twinkleSpeed;
        const alpha =
            star.opacity *
            (
                .55 +
                Math.sin(
                    star.twinkle
                ) * .45
            );
        /*
         * Маленький хвост
         */
        ctx.beginPath();
        ctx.moveTo(
            star.x,
            star.y
        );
        ctx.lineTo(
            star.x,
            star.y -
            star.speed * 8
        );
        ctx.strokeStyle =
            `rgba(
                255,
                255,
                255,
                ${alpha * .35}
            )`;
        ctx.lineWidth =
            star.radius;
        ctx.stroke();
        /*
         * Сама звезда
         */
        ctx.beginPath();
        ctx.arc(
            star.x,
            star.y,
            star.radius,
            0,
            Math.PI * 2
        );
        ctx.fillStyle =
            `rgba(
                255,
                255,
                255,
                ${alpha}
            )`;
        ctx.fill();
        /*
         * Glow у крупных звёзд
         */
        if (star.radius > 1) {
            ctx.beginPath();
            ctx.arc(
                star.x,
                star.y,
                star.radius * 4,
                0,
                Math.PI * 2
            );
            ctx.fillStyle =
                `rgba(
                    170,
                    190,
                    255,
                    ${alpha * .08}
                )`;
            ctx.fill();
        }
    }
    requestAnimationFrame(
        animateStars
    );
}
/* ==========================================
   CURSOR LIGHT
========================================== */
const cursorGlow =
    document.getElementById(
        "cursorGlow"
    );
let mouseX =
    window.innerWidth / 2;
let mouseY =
    window.innerHeight / 2;
let glowX = mouseX;
let glowY = mouseY;
document.addEventListener(
    "mousemove",
    (event) => {
        mouseX =
            event.clientX;
        mouseY =
            event.clientY;
    }
);
function animateCursor() {
    glowX +=
        (mouseX - glowX) * .12;
    glowY +=
        (mouseY - glowY) * .12;
    cursorGlow.style.left =
        glowX + "px";
    cursorGlow.style.top =
        glowY + "px";
    requestAnimationFrame(
        animateCursor
    );
}
/* ==========================================
   GLASS TILT
========================================== */
const card =
    document.getElementById(
        "glassCard"
    );
document.addEventListener(
    "mousemove",
    (event) => {
        if (
            !window.matchMedia(
                "(pointer: fine)"
            ).matches
        ) {
            return;
        }
        const x =
            event.clientX /
            window.innerWidth -
            .5;
        const y =
            event.clientY /
            window.innerHeight -
            .5;
        card.style.transform =
            `
            perspective(1100px)
            rotateY(${x * 5}deg)
            rotateX(${y * -5}deg)
            `;
    }
);
document.addEventListener(
    "mouseleave",
    () => {
        card.style.transform =
            `
            perspective(1100px)
            rotateY(0deg)
            rotateX(0deg)
            `;
    }
);
/* ==========================================
   START
========================================== */
window.addEventListener(
    "resize",
    resizeCanvas
);
resizeCanvas();
requestAnimationFrame(
    animateStars
);
requestAnimationFrame(
    animateCursor
);
</script>
</body>
</html>
